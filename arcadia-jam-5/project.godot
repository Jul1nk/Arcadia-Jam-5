; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ArcadiaJam5"
run/main_scene="uid://dhgpn3a632iin"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LimboConsole="*uid://dyxornv8vwibg"
ConsoleManager="*uid://db8eolunobfal"
UI="*uid://c34dewuxol6kl"
MusicManager="*uid://8a5fns0rtmh"
GameInfo="*uid://ccstcs8ngvirs"
ControllerIcons="*uid://d3n7i0r5tjqjd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg", "res://addons/ldtk-importer/plugin.cfg", "res://addons/limbo_console/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "green",
"res://sandbox/": "purple",
"res://scripts/": "gray",
"res://sfx/": "red",
"res://sprites/": "orange"
}

